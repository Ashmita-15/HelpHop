# ---- Server ----
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/volunteerconnect
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/volunteerconnect
MONGO_URI=mongodb://127.0.0.1:27017/volunteerconnect

# ---- Auth ----
# Any long random string. Change this in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Origin of the Vite dev server (comma-separated list allowed)
CLIENT_ORIGIN=http://localhost:5173

# ---- GenAI (optional) ----
# Get a key at https://aistudio.google.com/app/apikey
# If left empty, the app falls back to a built-in template generator
# and still works end to end.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
